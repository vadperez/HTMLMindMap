{
  "name": "HTML Mind Map",
  "short_name": "MindMap",
  "description": "Mind maps and reference maps kept as plain, self-contained HTML files on your own disk.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#F6F8FA",
  "lang": "en",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New map", "url": "./?new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tutorial", "url": "./tutorial.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
